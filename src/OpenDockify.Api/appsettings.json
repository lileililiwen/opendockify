{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=opendockify.db"
  },
  "Database": {
    "Provider": "sqlite"
  },
  "Jwt": {
    "Issuer": "opendockify",
    "Audience": "opendockify",
    "ExpiryMinutes": "15"
  },
  "Sharing": {
    "HashKey": "opendockify-local-dev-sharing-hash-key-please-change-32b"
  },
  "Web": {
    "Hsts": true,
    "Cors": {
      "AllowedOrigins": "http://localhost:8080"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Ai": {
    "AllowInsecureHttp": false,
    "Provider": "ollama",
    "ScrubPii": true,
    "MaxTokensPerDay": 20000
  },
  "Cache": {
    "RenderTtlMinutes": 10,
    "LprTtlHours": 24
  },
  "Notifications": {
    "Enabled": false
  },
  "Mailing": {
    "DefaultFromAddress": "noreply@opendockify.local",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "SecureMode": 1
    }
  },
  "RateLimiting": {
    "BypassTokens": []
  },
  "Quota": {},
  "Idempotency": {
    "Enabled": true,
    "RetentionSeconds": 86400
  },
  "Webhooks": {
    "MaximumOutboundBodyBytes": 1048576,
    "DefaultOutboundTimeout": "00:00:10",
    "DefaultMaxRetryAttempts": 5,
    "DefaultRetryBaseDelay": "00:00:05",
    "DefaultRetryMaxDelay": "00:15:00"
  },
  "Auth": {
    "AllowRegistration": false,
    "LoginAttemptsPerMinute": 10,
    "RegistrationAttemptsPerHour": 5,
    "RecoveryAttemptsPerHour": 3,
    "LockoutMaxFailures": 5,
    "LockoutWindowMinutes": 15,
    "RecoveryTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "DocumentsPath": "/app/data/documents",
    "Provider": "local",
    "Local": {
      "RootPath": "/app/data/objects"
    },
    "S3": {
      "BucketName": "",
      "KeyPrefix": "",
      "Region": "us-east-1",
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": ""
    },
    "MaximumObjectBytes": 268435456,
    "MaximumPresignLifetimeMinutes": 15
  },
  "Backup": {
    "Directory": "/app/data/backups",
    "DocumentsPath": "/app/data/documents",
    "ScheduleHours": 0,
    "RetainCount": 7,
    "RetainDays": 30
  },
  "Interviews": {
    "SessionLifetimeHours": 168
  },
  "Integrations": {
    "IdempotencyRetentionDays": 30,
    "MaxTokensPerOwner": 20,
    "MaxSubscriptionsPerOwner": 10,
    "Webhooks": {
      "Enabled": false,
      "MaxAttempts": 8,
      "BaseRetryDelaySeconds": 30,
      "TimeoutSeconds": 15,
      "LeaseMinutes": 5,
      "RetentionDays": 30,
      "PollIntervalSeconds": 5,
      "MaxRedirects": 3,
      "Allowlist": []
    }
  }
}
