# Copy this file to .env and replace both required placeholders before running
# docker compose. These examples are intentionally not valid production secrets.
OPENDOCKIFY_JWT_SECRET=replace-with-at-least-32-random-bytes
OPENDOCKIFY_ADMIN_USERNAME=admin
OPENDOCKIFY_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Public registration is disabled by default. Enable only when intended.
OPENDOCKIFY_ALLOW_REGISTRATION=false
